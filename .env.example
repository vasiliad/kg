# ==============================================================================
# DEEPSEEK-TPU-NIM AUTONOMOUS COMPLEX — ENVIRONMENT VARIABLES / GITHUB SECRETS
# ==============================================================================
# Copy to .env for local runs, or add each as a GitHub Repository Secret
# (Settings → Secrets and variables → Actions → New repository secret).
# The workflows reference them as ${{ secrets.NAME }}.
#
# This file is the COMPLETE inventory of what the complex reads — audited
# 2026-11-04. It used to list eight variables while the workflows read
# twenty, and it advertised a Kaggle TPU tier that NO CODE READS. A setup
# document that is out of date is worse than none: it makes the operator
# believe the complex is configured when it is not.
#
# The complex also PROVES its own configuration: the diagnostics cycle
# (harness/diagnostics.py) lists every missing credential and every dormant
# tier in its report, so the state of the wiring is never a guess.
# ==============================================================================

# ---- CRITICAL: NVIDIA NIM (build.nvidia.com → API Keys) --------------------
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional extra keys for automatic rotation on 401/429 (key_pool.py reads _2.._9)
# NVIDIA_API_KEY_2=nvapi-yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ---- The other model suppliers (the fleet is measured live, not assumed) ----
# A comma-separated pool; the complex rotates through it on 401/429.
TINYFISH_API_KEYS=
LANGSEARCH_API_KEY=

# ---- Web search -------------------------------------------------------------
KEENABLE_API_KEY=
# Tavily: the search tier of the model executor. Empty => the executor falls
# back to the other suppliers.
TAVILY_API_KEY=

# ---- Hugging Face (model downloads; Read scope is enough) ------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- GitHub PAT (classic, scopes: repo + workflow) -------------------------
# Needed for pushing state from any host other than Actions itself.
GH_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=vasiliad/kg

# ---- The salts: the privacy of every published fingerprint -----------------
# REDACTION_SALT keys the HMAC behind every address/chat fingerprint. Without
# it the complex falls back to a plain SHA-256 — still one-way, but a guessed
# id can be confirmed against the published tag.
REDACTION_SALT=
# VAULT_SALT opens the sealed vault (AES-256-GCM), where the complex keeps
# its own MEGA account credentials. The repository carries ciphertext only.
VAULT_SALT=

# ---- Daily email dispatch --------------------------------------------------
# This repository is PUBLIC. Real addresses must never be written here: the
# sender and the recipient live in the GitHub secrets of the same names, and
# the recipient is also changeable from Telegram (stored in the untracked
# data/.bot_settings.json).
GMAIL_SENDER=sender@example.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx          # 16-char Google App Password
DISPATCH_RECIPIENT_EMAIL=recipient@example.com

# ---- The wire's other two tiers (OPTIONAL — the primary works without them) -
# The backup account: used ONCE, only when the primary's wire fails (a
# refused password, a dropped connection). A backup that was never
# configured is not a backup — the diagnostics report says when it is dormant.
GMAIL_SENDER_2=backup@example.com
GMAIL_APP_PASSWORD_2=xxxxxxxxxxxxxxxx
# The archive copy: every letter rides the same SMTP session to this mailbox
# too, so the record survives the operator's inbox AND GitHub. Several
# addresses may be listed, separated by commas.
ARCHIVE_RECIPIENT_EMAIL=archive@example.com

# ---- The complex's own mailboxes (three independent providers) --------------
# The complex registers its own accounts, so it needs mailboxes of its own:
# these are the verification inboxes and the inbox the complex can READ
# unattended. mail.tm is the one with a plain REST API (read by
# harness/mail_accounts.py), Proton carries the cloud disk (Proton Drive),
# and Tuta is the non-Proton verification inbox.
# The real values live in .env (local) and in the sealed vault (cloud) —
# never in this file, this repository is PUBLIC.
PROTON_MAIL_ADDRESS=
PROTON_MAIL_USERNAME=
PROTON_MAIL_PASSWORD=
PROTON_MAIL_PLAN=Free
# The cloud disk shares the Proton login; Proton Drive is a separate surface.
PROTON_DRIVE_ADDRESS=
PROTON_DRIVE_PASSWORD=
# The TOTP secret of Proton's 2FA. Empty means 2FA is off on this account:
# set it before sealing the vault, or the cloud cannot log in unattended.
PROTON_DRIVE_2FA_SECRET=
TUTA_ADDRESS=
TUTA_PASSWORD=
# The recovery code is the only way back into Tuta — keep it with the password.
TUTA_RECOVERY_CODE=
MAILTM_ADDRESS=
MAILTM_PASSWORD=
MAILTM_TOKEN=

# ---- Telegram command center ------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz
# The control-channel passphrase. This repository is PUBLIC, so the real value
# must never be written here — keep it in the GitHub secret of the same name.
TELEGRAM_BOT_PASSWORD=your-passphrase-here
# The operator's chat id — an ADDRESS. It lives in the secret and nowhere
# else; the tracked state keeps only a fingerprint of it.
TELEGRAM_OPERATOR_CHAT_ID=

# ---- The sovereign CPU fallback ---------------------------------------------
# The complex can answer without any API key: the local model (Ollama) is the
# last resort. There is no key to set — but the model must be present
# (see config.yaml). The old «Kaggle TPU» section was removed because NO
# CODE READS THOSE VARIABLES: the tier was documented and never existed.

# ==============================================================================
# NOTE: never commit a real .env — it is gitignored.
# Public repositories get free GitHub-hosted runners (unlimited Actions minutes).
# ==============================================================================
