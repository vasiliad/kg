.telegram_sessions.json

# Derived semantic memory indexes.
# The durable source of truth is data/telegram_history.txt (conversation) and
# nim_history.log (events), both committed. These vector caches are rebuilt
# from them on every runner start, so they must never be committed or the
# repository grows by ~37 KB per remembered message.
data/.memory_vault.json
data/.event_vault.json

# The operator's own settings — the report recipient and the runtime
# preferences. The address lives in the `DISPATCH_RECIPIENT_EMAIL` secret
# and HERE, and nowhere else: this file was listed in the daemon's
# STATE_FILES, so the next `git add` would have committed the operator's
# personal address to the public repository.
data/.bot_settings.json

# Temporary MTProto session for the real-user bot test client
# (scripts/tg_user_test.py). The session grants access to the test Telegram
# account, so it must NEVER be committed; it is deleted by `logout`.
data/.tg_user_session*
data/.tg_code_hash

# Local previews of the rendered letters. They are built on the machine for
# a visual check and never belong in the public repository.
data/email_preview_*.html
